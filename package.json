{
  "name": "betterwork",
  "version": "0.0.1",
  "private": true,
  "description": "面向知识工作者的个人 AI 工作台，基于本地知识库与长期记忆完成深度研究、数据分析、Word 文档和 PPT。",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/desktop && npm run dev",
    "dev:start": "bash scripts/dev-start.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "npm run build --workspace @betterwork/desktop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project functional && vitest run --project heavy",
    "test:watch": "vitest --project functional --project heavy",
    "bench": "vitest run --project bench",
    "ui:check": "node scripts/ui-render-check.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run ui:check",
    "postinstall": "patch-package",
    "setup:runtime": "node node_modules/electron/install.js && electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "office:probe": "node scripts/office-input-probe.mjs",
    "km15:semantics": "npm run build && npx esbuild scripts/km15-semantic-probe.ts --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --outfile=node_modules/.cache/km15-semantic-probe.cjs --external:electron --external:better-sqlite3 && node node_modules/.cache/km15-semantic-probe.cjs",
    "expert:preflight": "node scripts/expert-release-preflight.mjs",
    "expert:acceptance-preflight": "node scripts/expert-acceptance-preflight.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "esbuild": "0.25.12",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  }
}
