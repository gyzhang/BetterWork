                  },
                  "extension": "pptx",
                  "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                  "validation": {
                    "structure": "passed",
                    "visual": "not-checked",
                    "manualEdit": "not-checked"
                  }
                }
              ]
            },
            "requireCompleteStdout": true,
            "runtimeInstruction": "校验命令成功并返回 outputIds 后，才可登记对应的 PPTX 成果。"
          }
