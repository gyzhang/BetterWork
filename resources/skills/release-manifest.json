      "profile": {
        "commands": [
          {
            "commandId": "project-init",
            "label": "初始化 PPT 项目",
            "argumentSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^(?!-)(?!\\.{1,2}$)[^/\\\\]+$"
                }
              },
              "required": ["project_name"]
            },
            "timeoutMs": 300000,
            "execution": {
              "entrypoint": {
                "scope": "toolchain",
                "runtime": "managed-python",
                "toolchainId": "ppt-master",
                "path": "skills/ppt-master/scripts/project_manager.py"
              },
              "pathArguments": [],
              "argv": [
                {
                  "kind": "literal",
                  "value": "init"
                },
                {
                  "kind": "argument",
                  "name": "project_name"
                },
                {
                  "kind": "literal",
                  "value": "--dir"
                },
                {
                  "kind": "work-directory"
                },
                {
                  "kind": "literal",
                  "value": "--quick-generate"
                },
                {
                  "kind": "literal",
                  "value": "--format"
                },
                {
                  "kind": "literal",
                  "value": "ppt169"
                }
              ],
              "outputs": []
            }
          },
          {
            "commandId": "icon-sync",
            "label": "同步图标",
            "argumentSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project_dir": {
                  "type": "string",
                  "minLength": 1
                },
                "icons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 100
                }
              },
              "required": ["project_dir", "icons"]
            },
            "timeoutMs": 300000,
            "execution": {
              "entrypoint": {
                "scope": "toolchain",
                "runtime": "managed-python",
                "toolchainId": "ppt-master",
                "path": "skills/ppt-master/scripts/icon_sync.py"
              },
              "pathArguments": [
                {
                  "argumentName": "project_dir",
                  "scope": "work",
                  "access": "read-write"
                }
              ],
              "argv": [
                {
                  "kind": "argument",
                  "name": "project_dir"
                },
                {
                  "kind": "argument",
                  "name": "icons",
                  "repeat": true
                }
              ],
              "outputs": []
            }
          },
          {
            "commandId": "svg-export",
            "label": "检查并导出 SVG",
            "argumentSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project_dir": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["project_dir"]
            },
            "timeoutMs": 300000,
            "execution": {
              "entrypoint": {
                "scope": "skill",
                "runtime": "managed-python",
                "path": "scripts/svg_native_export.py"
              },
              "pathArguments": [
                {
                  "argumentName": "project_dir",
                  "scope": "work",
                  "access": "read-write"
                }
              ],
              "argv": [
                {
                  "kind": "argument",
                  "name": "project_dir"
                },
                {
                  "kind": "literal",
                  "value": "--output"
                },
                {
                  "kind": "output",
                  "outputId": "pptx"
                }
              ],
              "outputs": [
                {
                  "outputId": "pptx",
                  "source": {
                    "kind": "generated",
                    "relativePath": ".attempts/{executionId}/betterwork-output.pptx"
                  },
                  "extension": "pptx",
                  "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                  "validation": {
                    "structure": "not-checked",
                    "visual": "not-checked",
                    "manualEdit": "not-checked"
                  }
                }
              ]
            },
            "runtimeInstruction": "使用本次工具返回的 outputIds 与执行记录继续流程；不要猜测历史导出目录或复用旧路径。"
          },
          {
            "commandId": "template-merge",
            "label": "合并公司模板",
            "argumentSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_pptx": {
                  "type": "string",
                  "minLength": 1
                },
                "template_path": {
                  "type": "string",
                  "minLength": 1
                },
                "config_path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["source_pptx", "template_path", "config_path"]
            },
            "timeoutMs": 300000,
            "execution": {
              "entrypoint": {
                "scope": "skill",
                "runtime": "managed-python",
                "path": "scripts/merge_into_template.py"
              },
              "pathArguments": [
                {
                  "argumentName": "source_pptx",
                  "scope": "work",
                  "access": "read"
                },
                {
                  "argumentName": "template_path",
                  "scope": "skill",
                  "access": "read"
                },
                {
                  "argumentName": "config_path",
                  "scope": "work",
                  "access": "read"
                }
              ],
              "argv": [
                {
                  "kind": "argument",
                  "name": "source_pptx"
                },
                {
                  "kind": "argument",
                  "name": "template_path"
                },
                {
                  "kind": "output",
                  "outputId": "merged-pptx"
                },
                {
                  "kind": "argument",
                  "name": "config_path"
                }
              ],
              "outputs": [
                {
                  "outputId": "merged-pptx",
                  "source": {
                    "kind": "generated",
                    "relativePath": ".attempts/{executionId}/merged.pptx"
                  },
                  "extension": "pptx",
                  "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                  "validation": {
                    "structure": "not-checked",
                    "visual": "not-checked",
                    "manualEdit": "not-checked"
                  }
                }
              ]
            },
            "runtimeInstruction": "template_path 指向本 Skill 的只读资源，使用 assets/ 开头的包内相对路径。"
          },
          {
            "commandId": "pptx-validate",
            "label": "校验 PPTX",
            "argumentSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pptx_path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["pptx_path"]
            },
            "timeoutMs": 300000,
            "execution": {
              "entrypoint": {
                "scope": "skill",
                "runtime": "managed-python",
                "path": "scripts/validate_pptx.py"
              },
              "pathArguments": [
                {
                  "argumentName": "pptx_path",
                  "scope": "work",
                  "access": "read"
                }
              ],
              "argv": [
                {
                  "kind": "argument",
                  "name": "pptx_path"
